{
  "name": "echo-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A two-player time-travel puzzle adventure. Cloudflare Workers + SQLite Durable Objects, with no paid game services.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "start:lan": "node scripts/dev-server.mjs --lan",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-android-emulator.ps1",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "cloudflare:dev": "npx --yes wrangler@4 dev",
    "deploy": "npx --yes wrangler@4 deploy"
  }
}
